# ============================================================
# KALU CRM - ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# ============================================================
# NUNCA COLOQUES CREDENCIALES REALES EN ESTE ARCHIVO.
# Copia este archivo como .env.development o .env.local para tu entorno.

# Entorno de ejecución
NODE_ENV=development

# Puertos
PORT=3001
VITE_PORT=3000

# Directorios de datos y uploads (Aislamiento DEV - FASE 1F-B)
DATA_DIR=./data-dev
UPLOAD_DIR=./data-dev/uploads

# Configuración de Correo (Modo DEV / Simulado)
# Opciones: development (solo log en consola), production (envío real SMTP)
MAIL_MODE=development
EMAIL_USER=dev-tester@example.com
EMAIL_PASS=

# Configuración de WhatsApp (Modo DEV / Simulado)
# Opciones: simulation (solo log en consola), production (Meta Cloud API)
WHATSAPP_MODE=simulation
WHATSAPP_PHONE_NUMBER_ID=1344089325449515
WHATSAPP_API_KEY=
WHATSAPP_VERIFY_TOKEN=kalu_dev_verification_token

# Google Gemini AI Server-Side (Robot Kalu / OCR / Asistente)
# Exclusivo del backend server-side (server.js). Cero variables VITE_ en frontend.
GEMINI_API_KEY=

# Socket.IO / CORS Allowlist (Fase 1D-D.2)
# Lista de orígenes permitidos separados por coma (e.g. http://localhost:3000,http://127.0.0.1:3000)
SOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
